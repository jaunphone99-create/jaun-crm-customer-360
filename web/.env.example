# =====================================================================================
# ตัวแปรสภาพแวดล้อมของแอป JAUN CRM
# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าให้ตรงกับเครื่อง/สภาพแวดล้อมของคุณ
# .env.local อยู่ใน .gitignore — ห้าม commit ค่าจริง
# =====================================================================================

# สภาพแวดล้อม: dev | staging | prod
# มีผลกับป้ายเตือนมุมจอ และกันไม่ให้ตัวต่อฐานข้อมูลโหมดพัฒนาหลุดขึ้นของจริง
JCRM_ENV=dev

# ตัวต่อฐานข้อมูล: dev | supabase
#   dev      = ต่อ tools/db/dev-api.mjs (PGlite ในเครื่อง · ไม่ต้องมี Docker/Supabase)
#              ใช้ได้เฉพาะ JCRM_ENV=dev เท่านั้น
#   supabase = ต่อ Supabase จริง (ต้องตั้งสองค่าด้านล่าง)
JCRM_DB_DRIVER=dev

# ที่อยู่ของ dev-api — ใช้เมื่อ JCRM_DB_DRIVER=dev
JCRM_DEV_API_URL=http://127.0.0.1:54329

# -------------------------------------------------------------------------------------
# ค่าของ Supabase — บังคับมีเมื่อ JCRM_DB_DRIVER=supabase
# หาได้จาก Supabase Dashboard → Project Settings → API
# -------------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# หมายเหตุความปลอดภัย
#   - แอปนี้ **ไม่ใช้** service_role key เด็ดขาด งานที่ต้องใช้สิทธิ์นั้นอยู่ใน Edge Function
#   - เซสชันเก็บใน cookie แบบ HttpOnly ทุกการเรียกที่ใช้เซสชันจึงอยู่ฝั่ง server เท่านั้น
#     (CANONICAL ข้อ 9.2 · docs/02-architecture/system-architecture.md §6.3)
