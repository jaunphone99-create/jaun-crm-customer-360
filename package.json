{
  "name": "jaun-crm-customer-360",
  "version": "0.0.0-phase0",
  "private": true,
  "description": "JAUN CRM · Customer 360 — Phase 0: เอกสาร · Supabase migrations · prototype",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "node tools/db/run.mjs",
    "db:test": "node tools/db/run.mjs --seed --test --quiet",
    "db:test:verbose": "node tools/db/run.mjs --seed --test",
    "db:dictionary": "node tools/db/gen-data-dictionary.mjs",
    "check:prototype": "node tools/check-prototype.mjs",
    "check:canonical": "node tools/check-canonical.mjs",
    "check": "npm run check:secrets && npm run check:canonical && npm run check:prototype && npm run check:web && npm run db:test",
    "db:seed": "node tools/db/gen-seed.mjs",
    "dev:db": "node tools/db/dev-api.mjs",
    "dev:db:fresh": "node tools/db/dev-api.mjs --fresh",
    "dev:web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "check:web": "npm --prefix web run check",
    "smoke": "python3 tools/smoke-test.py",
    "check:secrets": "node tools/check-secrets.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1"
  }
}
